LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
    IDS_APP_TITLE           "Sparkborne"
    IDS_MENU_FILE           "File"
    IDS_MENU_EXIT           "Exit"
    IDS_MENU_STARTUP        "Startup items"
    IDS_MENU_REFRESH        "Refresh"
    IDS_MENU_HELP           "Help"
    IDS_MENU_MORE_WORKS     "More things made by me..."
    IDS_WINDOW_HINT         "Select startup items from the left list to view details and actions."
    IDS_ITEM_ENABLED        "Enabled"
    IDS_ITEM_DISABLED       "Disabled"
    IDS_ITEM_TYPE_REGISTRY  "Registry"
    IDS_ITEM_TYPE_SHORTCUT  "Shortcut"
    IDS_ITEM_DETAILS_FMT    "Name: %s\nType: %s\nSource: %s\nPath/Command: %s\nStatus: %s\n\n%s"
    IDS_ENABLE_ACTION       "Enable this startup item?"
    IDS_DISABLE_ACTION      "Disable this startup item?"
    IDS_ERROR_TITLE         "Sparkborne"
    IDS_ACTION_FAILED_FMT   "Operation failed:\n%s"
    IDS_WEB_WINDOW_TITLE    "More things made by me"
    IDS_REGISTRY_HKCU_RUN   "HKCU Run"
    IDS_REGISTRY_HKCU_DISABLED "HKCU -Run"
    IDS_REGISTRY_HKLM_RUN   "HKLM Run"
    IDS_REGISTRY_HKLM_DISABLED "HKLM -Run"
    IDS_COM_INIT_FAILED     "Failed to initialize COM runtime."
    IDS_ATL_INIT_FAILED     "Failed to initialize ATL ActiveX hosting."
    IDS_PANEL_ITEM_DETAILS_FMT "Name: %s\r\nType: %s\r\nSource: %s\r\nPath/Command: %s\r\nStatus: %s"
    IDS_PANEL_NO_SELECTION  "Select a startup item from the list on the left."
    IDS_BUTTON_ENABLE       "Enable"
    IDS_BUTTON_DISABLE      "Disable"
    IDS_BUTTON_DELETE       "Delete"
    IDS_BUTTON_LAUNCH_NOW   "Launch now"
    IDS_CONFIRM_DELETE      "Delete this startup item?"
END

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_APP_TITLE           "Sparkborne"
    IDS_MENU_FILE           "文件"
    IDS_MENU_EXIT           "退出"
