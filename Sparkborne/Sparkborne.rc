    IDS_ATL_INIT_FAILED     "初始化 ATL ActiveX 宿主失败。"
    IDS_PANEL_ITEM_DETAILS_FMT "名称：%s\r\n类型：%s\r\n来源：%s\r\n路径/命令：%s\r\n状态：%s"
    IDS_PANEL_NO_SELECTION  "请在左侧列表中选择一个启动项。"
    IDS_BUTTON_ENABLE       "启用"
    IDS_BUTTON_DISABLE      "禁用"
    IDS_BUTTON_DELETE       "删除"
